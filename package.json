{
  "name": "@hagicode/imgbin",
  "version": "0.1.0",
  "description": "CLI tooling for generating, annotating, and indexing image assets.",
  "license": "MIT",
  "homepage": "https://github.com/HagiCode-org/imgbin#readme",
  "bugs": {
    "url": "https://github.com/HagiCode-org/imgbin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/imgbin.git"
  },
  "type": "module",
  "bin": {
    "imgbin": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md"
  ],
  "scripts": {
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=4096\"; tsc -p tsconfig.json",
    "clean": "rm -rf dist .vitest-temp .tmp coverage",
    "dev": "tsx src/cli.ts",
    "pack:check": "node scripts/verify-package.mjs",
    "publish:prepare-dev-version": "node scripts/prepare-dev-version.mjs",
    "publish:verify-release": "node scripts/verify-release-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "keywords": [
    "hagicode",
    "hagicode-org",
    "cli",
    "image",
    "image-generation",
    "metadata",
    "thumbnail",
    "annotation",
    "ai-image"
  ],
  "author": {
    "name": "HagiCode",
    "url": "https://github.com/HagiCode-org"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "sharp": "^0.34.4",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
